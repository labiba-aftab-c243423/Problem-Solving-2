#include <bits/stdc++.h>
using namespace std;

struct DSU {
    vector<int> parent, rankv;

    DSU(int n) {
        parent.resize(n + 1);
        rankv.resize(n + 1, 0);
        for (int i = 0; i <= n; i++)
            parent[i] = i;
    }

    int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);
        return parent[x];
    }

    bool unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a == b) return false;

        if (rankv[a] < rankv[b])
            swap(a, b);

        parent[b] = a;

        if (rankv[a] == rankv[b])
            rankv[a]++;

        return true;
    }
};

int main() {
    int g_nodes, g_edges;
    cin >> g_nodes >> g_edges;

    vector<tuple<int, int, int>> edges;

    for (int i = 0; i < g_edges; i++) {
        int u, v, w;
        cin >> u >> v >> w;

        if (u > v) swap(u, v);
        edges.push_back({w, u, v});
    }

    sort(edges.begin(), edges.end());

    DSU dsu(g_nodes);
    long long totalWeight = 0;

    for (auto &[w, u, v] : edges) {
        if (dsu.unite(u, v)) {
            totalWeight += w;
        }
    }

    cout << totalWeight << endl;

    return 0;
}
