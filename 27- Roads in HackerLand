#include <bits/stdc++.h>
using namespace std;

struct DSU {
    vector<int> p, sz;

    DSU(int n) {
        p.resize(n);
        sz.assign(n, 1);
        iota(p.begin(), p.end(), 0);
    }

    int find(int x) {
        return p[x] == x ? x : p[x] = find(p[x]);
    }

    bool unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a == b) return false;

        if (sz[a] < sz[b]) swap(a, b);

        p[b] = a;
        sz[a] += sz[b];
        return true;
    }
};

struct Edge {
    int u, v, c;
};

vector<vector<pair<int,int>>> tree;
vector<long long> cnt;
int n;

long long dfs(int u, int p) {
    long long sz = 1;

    for (auto &e : tree[u]) {
        int v = e.first;
        int w = e.second;

        if (v == p) continue;

        long long sub = dfs(v, u);

        cnt[w] += sub * (n - sub);

        sz += sub;
    }

    return sz;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int m;
    cin >> n >> m;

    vector<Edge> edges(m);

    for (int i = 0; i < m; i++) {
        cin >> edges[i].u >> edges[i].v >> edges[i].c;
        edges[i].u--;
        edges[i].v--;
    }

    sort(edges.begin(), edges.end(),
         [](const Edge &a, const Edge &b) {
             return a.c < b.c;
         });

    DSU dsu(n);

    tree.assign(n, {});
    cnt.assign(m + 25, 0);

    for (auto &e : edges) {
        if (dsu.unite(e.u, e.v)) {
            tree[e.u].push_back({e.v, e.c});
            tree[e.v].push_back({e.u, e.c});
        }
    }

    dfs(0, -1);

    vector<long long> bits(400000, 0);

    for (int i = 0; i < cnt.size(); i++) {
        bits[i] += cnt[i];
    }

    for (int i = 0; i < (int)bits.size() - 1; i++) {
        bits[i + 1] += bits[i] / 2;
        bits[i] %= 2;
    }

    int pos = bits.size() - 1;
    while (pos > 0 && bits[pos] == 0) pos--;

    for (int i = pos; i >= 0; i--) {
        cout << bits[i];
    }

    cout << '\n';

    return 0;
}
